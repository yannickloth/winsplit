// opencode.jsonc — standard audit-agent config (mirrors ../modelmux).
//
// The ten general-skills audit agents declare `model: sonnet` in their
// frontmatter, but the plugin drops bare model aliases at registration
// (only `provider/model` survives), so they would fall back to the session
// default (a small local model). The `agent` block pins them to
// `deepseek/deepseek-v4-pro`. A repo-declared agent REPLACES the plugin's
// registration, so each pin carries the full agent: `prompt` via
// `{file:...}`, `mode`, and the permission block.
//
// `instructions` injects the agentmem memory-system prompt.

{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "../llm-harness-plugins/agentmem/opencode"
  ],
  "instructions":   [
    "../llm-harness-plugins/agentmem/prompts/agent-prompt.md"
  ],
  "agent":   {
    "bibliography-auditor": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "thinking": {
        "type": "enabled"
      },
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/bibliography-auditor.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "edit": "deny",
        "task": "deny"
      }
    },
    "citation-fidelity-auditor": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "thinking": {
        "type": "enabled"
      },
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/citation-fidelity-auditor.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "task": "deny"
      }
    },
    "config-auditor": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "thinking": {
        "type": "enabled"
      },
      "prompt": "{file:../llm-harness-plugins/general-skills/agents/config-auditor.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "edit": "deny",
        "task": "deny"
      }
    },
    "logic-auditor": {
      "mode": "subagent",
